# Local values are generated automatically by `npm run local:start`.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_BACKEND_URL=http://host.docker.internal:54321
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this value to the browser.
SUPABASE_SECRET_KEY=

# Local Supabase PostgreSQL as reached from the SiteOps backend container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres

# One-time bootstrap. Remove the password after the Super Admin is linked.
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@siteops.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# One-time legacy migration only. Remove after running the linking command.
MIGRATION_TEMP_PASSWORD=

VITE_API_BASE=http://localhost:8000

FRONTEND_URL=http://localhost:3000

# Meta WhatsApp Cloud API (see backend/app/services/whatsapp_provider.py).
# From Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
