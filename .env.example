# SiteOps environment variables. Copy to .env for local docker-compose use
# (local values are generated automatically by `npm run local:start`), or
# set the equivalent names in Render/Vercel dashboards for staging/prod.
#
# Two naming conventions appear below for a few Supabase/bootstrap vars:
# the original docker-compose-plumbed names, and the SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY / SUPER_ADMIN_* names used by deployment
# platforms and app/scripts/bootstrap_super_admin.py. backend/app/config.py
# accepts EITHER name for the same setting (see AliasChoices in config.py) -
# you do not need to set both, pick whichever your platform's tooling
# expects. Render/staging docs in this repo use the SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY / SUPER_ADMIN_* names.

# ============================================================
# BACKEND (FastAPI) - server-side only, never shipped to the browser
# ============================================================

# Deployment mode. "local" enables auto-seeding of a dev Super Admin and a
# sample execution template on startup. Any other value (staging,
# production) disables that path - use bootstrap_super_admin.py instead.
ENVIRONMENT=local

# Postgres connection string the backend uses (Supabase Postgres locally or
# in staging/prod; alembic also reads this to apply backend/alembic/ migrations).
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres

# Comma-separated list of allowed browser origins for CORS. No wildcards in
# staging/production. FRONTEND_URL (below) is a convenience single-origin
# value some deploy configs reuse for this.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Canonical frontend origin, used for building Supabase email-redirect links
# (password reset / verification) and as a CORS_ORIGINS fallback.
FRONTEND_URL=http://localhost:3000

# Supabase project URL as reached FROM THE BACKEND (server network path -
# e.g. host.docker.internal locally, the public project URL in staging/prod).
# Alias: SUPABASE_BACKEND_URL (legacy docker-compose name for this value).
SUPABASE_URL=http://host.docker.internal:54321

# Supabase publishable/anon key. Safe to be non-secret, but still only
# consumed server-side here (verify_access_token's HTTP fallback path).
SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role key. SECRET. Grants Supabase Admin API access
# (used to create/list/update Auth users). Never expose to the frontend
# bundle or any VITE_-prefixed variable.
# Alias: SUPABASE_SECRET_KEY (legacy docker-compose name for this value).
SUPABASE_SERVICE_ROLE_KEY=

# --- One-time Super Admin bootstrap (app/scripts/bootstrap_super_admin.py) ---
# Opt-in switch. Set to "true" for exactly one run against a fresh
# staging/production database, then set back to "false"/unset it.
BOOTSTRAP_SUPER_ADMIN=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
# Aliases accepted by config.py for the same two values, kept for the local
# docker-compose flow (backend/app/seed.py's local-only auto-seed path):
# BOOTSTRAP_SUPER_ADMIN_EMAIL, BOOTSTRAP_SUPER_ADMIN_PASSWORD

# One-time legacy user migration only (app/scripts/link_supabase_users.py).
# Remove/unset after running the linking command.
MIGRATION_TEMP_PASSWORD=

# ============================================================
# FRONTEND (Vite) - VITE_-prefixed vars are baked into the browser bundle
# at build time. NEVER put a secret (service_role/SUPABASE_SECRET_KEY) in
# any VITE_ variable.
# ============================================================

# Supabase project URL as reached FROM THE BROWSER (public URL).
# Alias accepted by frontend/src/lib/supabase.js: VITE_SUPABASE_URL (same name).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable/anon key (public, safe for the browser bundle).
# Primary name read by the app: VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY is also accepted as an alias.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Base URL of the SiteOps backend API as reached from the browser.
# Primary name read by the app: VITE_API_BASE.
# VITE_API_BASE_URL is also accepted as an alias.
VITE_API_BASE=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
